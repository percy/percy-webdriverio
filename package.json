{
  "name": "@percy/webdriverio",
  "description": "WebdriverIO client library for visual testing with Percy",
  "version": "3.3.4",
  "license": "MIT",
  "author": "Perceptual Inc.",
  "repository": "https://github.com/percy/percy-webdriverio",
  "keywords": [
    "webdriverio",
    "percy",
    "visual testing"
  ],
  "main": "index.js",
  "types": "types/index.d.ts",
  "files": [
    "index.js",
    "_iframe_shim.js",
    "types/index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint --ignore-pattern .gitignore .",
    "test": "percy exec --testing -- wdio wdio.conf.js",
    "test:coverage": "nyc yarn test",
    "test:types": "tsd",
    "test:types:consumer": "tsc -p types/consumer && tsc -p types/consumer-nodenext"
  },
  "dependencies": {
    "@percy/sdk-utils": "^1.32.0"
  },
  "peerDependencies": {
    "webdriverio": "^8.14.0 || ^9 || ^10"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@percy/cli": "^1.32.0",
    "@wdio/cli": "^10.0.1",
    "@wdio/jasmine-framework": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "eslint": "^9.13.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "globals": "^15.11.0",
    "jasmine": "^6.0.0",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.1",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "webdriverio": "^10.0.1"
  }
}
